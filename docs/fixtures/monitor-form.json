{
  "type": "modal",
  "title": {
    "type": "plain_text",
    "text": "New coverage search",
    "emoji": false
  },
  "close": {
    "type": "plain_text",
    "text": "Close",
    "emoji": false
  },
  "blocks": [
    {
      "type": "input",
      "block_id": "name",
      "label": {
        "type": "plain_text",
        "text": "Company, brand, or person",
        "emoji": false
      },
      "optional": false,
      "element": {
        "type": "plain_text_input",
        "action_id": "value",
        "multiline": false,
        "max_length": 100
      },
      "hint": {
        "type": "plain_text",
        "text": "Example: Patagonia",
        "emoji": false
      }
    },
    {
      "type": "input",
      "block_id": "campaign",
      "label": {
        "type": "plain_text",
        "text": "Campaign or product focus",
        "emoji": false
      },
      "optional": true,
      "element": {
        "type": "plain_text_input",
        "action_id": "value",
        "multiline": false,
        "max_length": 300
      },
      "hint": {
        "type": "plain_text",
        "text": "Optional. General coverage is collected too.",
        "emoji": false
      }
    },
    {
      "type": "input",
      "block_id": "messages",
      "label": {
        "type": "plain_text",
        "text": "Messages to check",
        "emoji": false
      },
      "optional": true,
      "element": {
        "type": "plain_text_input",
        "action_id": "value",
        "multiline": true,
        "max_length": 3000
      },
      "hint": {
        "type": "plain_text",
        "text": "Optional, one per line. Example: The company supports repairing clothing. Research checks these against available evidence.",
        "emoji": false
      }
    },
    {
      "type": "input",
      "block_id": "freshness",
      "label": {
        "type": "plain_text",
        "text": "Time range",
        "emoji": false
      },
      "element": {
        "type": "static_select",
        "action_id": "value",
        "placeholder": {
          "type": "plain_text",
          "text": "Choose",
          "emoji": false
        },
        "options": [
          {
            "text": {
              "type": "plain_text",
              "text": "Past day",
              "emoji": false
            },
            "value": "pd"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "Past week",
              "emoji": false
            },
            "value": "pw"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "Past month",
              "emoji": false
            },
            "value": "pm"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "Past year",
              "emoji": false
