# Copy to .env and edit locally. Never paste secret values into a chat.
# Implemented local Slack application. See README.md for setup and runtime sign-in.
# demo = labeled fixtures for retrieval/analysis, with no live AI/search requests.
# live = real providers only; ALLOW_LIVE_CALLS must also be true.
APP_MODE=demo
ALLOW_LIVE_CALLS=false

# Slack bot token (xoxb-...), from OAuth & Permissions.
SLACK_BOT_TOKEN=
# Slack app-level token (xapp-...), with connections:write.
SLACK_APP_TOKEN=
# Non-secret: your Slack member ID. Only this user can start live AI or publish.
SLACK_OWNER_USER_ID=
# Optional expected workspace ID; otherwise bind to Slack auth.test's team_id.
SLACK_WORKSPACE_ID=
# Public development channel where the bot has been invited.
SLACK_DEMO_CHANNEL_ID=

# Codex uses managed ChatGPT sign-in: there is no model API key field.
# Custom app setting; map to CODEX_HOME only inside the runtime/login subprocess.
# Codex must expand ~. Keep outside the repo and outside shared/synced folders.
COVERAGE_CODEX_HOME=~/.coverage-desk-codex
# Optional executable path; blank uses the official SDK's bundled/pinned runtime.
CODEX_BIN=
# Select from the actual ChatGPT-authenticated runtime's available models.
# Blank selects a compatible lightweight model only after model/list verification.
CODEX_MODEL=
# Optional, only when the selected model supports the chosen value.
CODEX_REASONING_EFFORT=
CODEX_JOB_TIMEOUT_SECONDS=90
CODEX_MAX_CONCURRENT_JOBS=1
CODEX_MAX_QUEUED_JOBS=3
CODEX_MAX_JOB_RETRIES=0

BRAVE_API_KEY=
# Enable only after confirming the applicable plan explicitly permits storage.
BRAVE_STORAGE_ALLOWED=false
# Optional: restrict this key to YouTube Data API v3.
YOUTUBE_API_KEY=

# Scheduling is optional; scheduled jobs must never invoke the Codex worker.
ENABLE_SCHEDULED_DIGESTS=false
DATABASE_PATH=./data/coverage-desk.sqlite3
RECORD_RETENTION_DAYS=7

# App-level limits. These are NOT guarantees about server token use or billing.
# Counts include retries, and exhaustion must be visible in the UI.
MAX_SOURCE_CALLS_PER_RUN=12
MAX_PAGES_PER_SOURCE=2
MAX_RESULTS_PER_SOURCE=30
MAX_AI_CALLS_PER_RUN=5
MAX_AI_ITEMS_PER_RUN=15
MAX_AI_INPUT_CHARS_PER_ITEM=8000
MAX_AI_INPUT_CHARS_PER_JOB=24000
MAX_AI_OUTPUT_CHARS_PER_JOB=16000
